# ==============================================================================
# HireNest Australia (.env.example)
# Copy this file to .env for local development or configure these in Render dashboard.
# NEVER commit real secret values to GitHub.
# ==============================================================================

# Django Core Security & Debug
SECRET_KEY=your-super-secret-key-at-least-50-characters-long
DEBUG=False

# Host & Origin Security (Comma-separated for multiple hosts)
# Note: Render automatically provides RENDER_EXTERNAL_HOSTNAME, but you can add custom domains here.
ALLOWED_HOSTS=hirenest.com.au,www.hirenest.com.au,.hirenest.com.au,.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://hirenest.com.au,https://www.hirenest.com.au,https://*.onrender.com,http://localhost:8002,http://127.0.0.1:8002
SECURE_SSL_REDIRECT=1

# Public site URL used by django.contrib.sites / django-allauth.
# Local development: http://127.0.0.1:8002  (HireNest runs on port 8002 locally)
# Production:        https://hirenest.com.au
SITE_URL=https://hirenest.com.au
SITE_NAME=HireNest Australia

# Database Configuration (PostgreSQL on Render)
# Render provides DATABASE_URL automatically if you link a Render PostgreSQL database.
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Alternative individual DB credentials (used if DATABASE_URL is not provided)
DB_NAME=talentvault_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# TalentVault Recruiter Workspace Redirection URL
TALENTVAULT_RECRUITER_WORKSPACE_URL=https://talent-vault.in/dashboard/recruiter/

# AWS S3 Storage for Resumes & Media Uploads (Optional - falls back to local storage if unset)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=talentvault-files-india
AWS_S3_REGION_NAME=ap-south-1
# AWS_S3_CUSTOM_DOMAIN=cdn.hirenest.com.au
# USE_LOCAL_STORAGE=0

# Candidate "Continue with Google" OAuth (django-allauth)
# Create these in Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Client).
# Authorised redirect URI: https://<your-domain>/accounts/google/login/callback/
# NEVER commit real client secrets. These are read from the environment only.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# SMTP & Email Delivery Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HireNest Australia <noreply@hirenest.com.au>

